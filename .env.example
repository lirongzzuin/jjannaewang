# ─── Supabase (DB) ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx
SUPABASE_SERVICE_ROLE_KEY=xxx

# ─── Upstash Redis (rate limiting, rankings, hot-tips cache) ──────
UPSTASH_REDIS_REST_URL=xxx
UPSTASH_REDIS_REST_TOKEN=xxx

# ─── Naver Shopping API (price collection) ───────────────────────
NAVER_CLIENT_ID=xxx
NAVER_CLIENT_SECRET=xxx

# (optional / unused) Coupang Partners
COUPANG_ACCESS_KEY=xxx
COUPANG_SECRET_KEY=xxx

# ─── Cron + app ──────────────────────────────────────────────────
CRON_SECRET=xxx
NEXT_PUBLIC_APP_URL=https://jjannaewang.vercel.app

# ─── Session / auth ──────────────────────────────────────────────
# HMAC secret used to sign SPA session tokens. Generate a long random value.
SESSION_SECRET=change-me-to-a-long-random-string

# CORS: comma-separated extra origins allowed to call this backend.
# *.tossmini.com is always allowed; add your CDN host + local dev as needed.
ALLOWED_ORIGINS=http://localhost:5173

# ─── Apps-in-Toss partner APIs (production) ──────────────────────
# Without these the auth exchange falls back to a sandbox user and push
# notifications/order verification are mocked. REQUIRED before real launch.
TOSS_PARTNER_API_BASE=https://apps-in-toss-api.toss.im
TOSS_PARTNER_CLIENT_ID=xxx
# Smart Messaging (server push) — partner token with message-send scope
TOSS_SMART_MESSAGE_TOKEN=xxx
# Registered message template codes (console: 알림 동의문 / templateCode)
TOSS_TEMPLATE_PRICE_DROP=price_drop_alert
TOSS_TEMPLATE_DAILY_REPORT=daily_savings_report
TOSS_TEMPLATE_HOT_DEAL=hot_deal_alert
